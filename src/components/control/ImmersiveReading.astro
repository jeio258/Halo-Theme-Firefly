---
// 沉浸式阅读入口按钮（自 Firefly ImmersiveReading 迁移，2026-09-23）
// 放置于浮控组（BackToTop.astro 的 .floating-controls）；默认 .hide，
// 由 immersive-reading.js 按「文章页 + 桌面端 + 后台开关」控制显隐。
// 进入沉浸态后图标切换为退出（.toggled 门控，同 toc-btn 的交叉淡入模式）。
import { Icon } from "astro-icon/components";
---

<div
  id="immersive-reading-btn"
  class="floating-btn immersive-btn hide flex items-center rounded-2xl overflow-hidden pointer-events-none"
>
  <button
    type="button"
    aria-label="Enter Immersive Reading"
    class="btn-card h-[3.5rem] w-[3.5rem] rounded-2xl relative"
  >
    <!-- 进入图标 / 退出图标：绝对定位重叠，交叉淡入 + 旋转（同 toc-btn 模式） -->
    <Icon
      name="material-symbols:auto-stories"
      class="immersive-enter-icon absolute inset-0 m-auto"
    />
    <Icon
      name="material-symbols:logout"
      class="immersive-exit-icon absolute inset-0 m-auto"
    />
  </button>
</div>

<style is:global>
  /* 沉浸按钮位置：位于目录按钮（bottom: 7rem+1.5rem）之上，独立定位不与其它按钮联动 */
  .immersive-btn {
    bottom: calc(10.5rem + 2.25rem);
    font-size: 1.8rem;
    opacity: 1;
    pointer-events: auto;
    transition:
      bottom var(--dur-float, 350ms) cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease;
  }

  .immersive-btn.hide {
    opacity: 0;
    pointer-events: none;
  }

  /* 图标切换：进入（auto-stories）↔ 退出（logout） */
  .immersive-btn .immersive-enter-icon,
  .immersive-btn .immersive-exit-icon {
    transition:
      opacity 180ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 180ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .immersive-btn .immersive-exit-icon {
    opacity: 0;
    transform: scale(0.4) rotate(-90deg);
  }

  .immersive-btn.toggled .immersive-enter-icon {
    opacity: 0;
    transform: scale(0.4) rotate(90deg);
  }

  .immersive-btn.toggled .immersive-exit-icon {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-btn .immersive-enter-icon,
    .immersive-btn .immersive-exit-icon {
      transition: none;
    }
  }
</style>
