---
// 时间天气小组件（对标 moesora「时间天气」）：天气大字置顶（图标 + 大温度 / 状况 + 城市）
// + 底部虚线时间行（秒级时钟 HH:MM:SS + M月D日 周X），可选「使用精确定位」GPS 按钮。
// - 天气数据双链路：① tencent_key 已配置 → 腾讯链路（JSONP：IP 定位→adcode→实况，
//   更贴近国内天气口径；失败/限流自动回退免 Key 兜底）；② tencent_key 留空（默认）→
//   免 Key 的 open-meteo 链路（城市名 geocode → 经纬度 → current 实况），城市留空时按
//   访客 IP 定位（api.ip.sb → ipwho.is 双源兜底），GPS 按钮走浏览器定位 +
//   bigdatacloud 反地理编码（localStorage 7 天缓存避免重复弹窗）
// - 后台配置（sidebar.weather 分组）：city 城市名（留空=IP 定位）、gps 精确定位按钮开关；
//   tencent_key 同时供欢迎弹窗 IP 定位复用（共享 weather_ip_cache）
// - 星期/月份文案复用 widget.calendar.* 词条（与站点日历单一来源）；日期行的单位、
//   语序与分隔符由 widget.weather.dateFormat 词条决定，不在代码里写死中文语序
// - 实例作用域取法同其他小组件，双实例各自一份时钟（card.__wxTimer 去重，元素离 DOM 自停）
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
  class?: string;
}
const className = Astro.props.class;
---

<WidgetLayout
  name="时间天气"
  nameKey="widget.weather.title"
  id="weather"
  class={className}
>
  {/* 隐藏的图标元素，供 Tailwind 构建时检测生成 CSS（WMO 映射用到的 mdi 图标全部在此登记） */}
  <div class="hidden">
    <span class="icon-[mdi--loading]"></span>
    <span class="icon-[mdi--weather-sunny]"></span>
    <span class="icon-[mdi--weather-cloudy]"></span>
    <span class="icon-[mdi--weather-cloudy-alert]"></span>
    <span class="icon-[mdi--weather-rainy]"></span>
    <span class="icon-[mdi--weather-pouring]"></span>
    <span class="icon-[mdi--weather-lightning-rainy]"></span>
    <span class="icon-[mdi--weather-snowy]"></span>
    <span class="icon-[mdi--weather-snowy-heavy]"></span>
    <span class="icon-[mdi--weather-fog]"></span>
    <span class="icon-[mdi--weather-night]"></span>
    <span class="icon-[mdi--map-marker]"></span>
  </div>

  <div
    th:attr="data-city=${theme.config?.sidebar?.weather?.city},
      data-tencent-key=${theme.config?.sidebar?.weather?.tencent_key}"
    class="wx-card px-3 py-1"
  >
    <!-- 天气主区：大图标 + 大温度 / 状况 + 城市 -->
    <div class="flex items-center gap-3.5 px-0.5 pb-2 pt-1">
      <span
        data-role="icon"
        class="flex h-[50px] w-[50px] flex-none items-center justify-center text-(--primary)"
      >
        <span class="icon-[mdi--loading] animate-spin text-4xl"></span>
      </span>
      <div class="min-w-0 flex-1">
        <div
          data-role="temp"
          class="text-3xl font-extrabold leading-none tabular-nums text-neutral-900 dark:text-neutral-100"
        >
          --°
        </div>
        <div class="mt-1 flex items-center gap-2 text-[13px]">
          <span
            data-role="cond"
            class="font-semibold text-neutral-700 dark:text-neutral-300"
            th:text="#{widget.weather.fetching}"
          >
            获取中…
          </span>
          <span class="inline-flex min-w-0 items-center gap-1 overflow-hidden">
            <span class="icon-[mdi--map-marker] shrink-0 text-xs text-(--primary)"></span>
            <span
              data-role="city"
              class="truncate text-neutral-500 dark:text-neutral-400"
            >
              --
            </span>
          </span>
        </div>
        <div
          data-role="aux"
          class="mt-1 text-xs text-neutral-400 dark:text-neutral-500"
        ></div>
      </div>
    </div>

    <!-- 时间行：虚线分隔 + 秒级时钟 / 日期（脚本填充） -->
    <div class="flex items-baseline justify-between gap-2 border-t border-dashed border-neutral-200 pt-2.5 dark:border-neutral-700">
      <span
        data-role="time"
        class="text-[17px] font-bold tabular-nums text-neutral-900 dark:text-neutral-100"
      >
        --:--:--
      </span>
      <span
        data-role="date"
        class="text-xs text-neutral-500 dark:text-neutral-400"
      >
        ----
      </span>
    </div>

    <!-- GPS 精确定位按钮：后台 gps 开关开启才渲染，城市留空时客户端显示 -->
    <button
      type="button"
      data-role="gps"
      th:if="${theme.config?.sidebar?.weather?.gps == true}"
      class="mx-auto mt-2.5 inline-flex items-center gap-1.5 rounded-full border border-neutral-200 px-3 py-1 text-xs text-(--primary) transition-colors hover:bg-(--btn-plain-bg-hover) dark:border-neutral-700"
      style="display: none"
    >
      <span class="icon-[mdi--map-marker] text-xs"></span>
      <span data-role="gpstext" th:text="#{widget.weather.gps}">
        使用精确定位
      </span>
    </button>
  </div>
</WidgetLayout>

<script is:inline>
  (function () {
    // 实例作用域：脚本 is:inline、每实例各跑一份，重复配置（左栏 + 右栏、桌面 + 移动端列表）
    // 时只操作本实例——currentScript 取本实例所在条目容器再查元素，
    // 否则永远命中文档第一个实例，重复的那份是空壳。
    var widgetRoot =
      (document.currentScript && document.currentScript.parentElement) ||
      document;
    var card = widgetRoot.querySelector(".wx-card");
    if (!card) return;

    // i18n 取词：Layout.astro 在 head 无条件注入 window.__etherealI18n（单一来源）
    var t =
      window.__etherealI18n ||
      function (_k, fb) {
        return fb;
      };
    var langTag = (
      window.__etherealLangTag ||
      function () {
        return "en";
      }
    )(document.documentElement.lang);

    var elIcon = card.querySelector('[data-role="icon"]');
    var elTemp = card.querySelector('[data-role="temp"]');
    var elCond = card.querySelector('[data-role="cond"]');
    var elCity = card.querySelector('[data-role="city"]');
    var elAux = card.querySelector('[data-role="aux"]');
    var elTime = card.querySelector('[data-role="time"]');
    var elDate = card.querySelector('[data-role="date"]');
    var gpsBtn = card.querySelector('[data-role="gps"]');
    var gpsTxt = gpsBtn ? gpsBtn.querySelector('[data-role="gpstext"]') : null;

    // 后台配置：城市名（留空=按 IP / GPS 定位）与腾讯 Key（留空=免 Key 链路）。
    // 必须在此处读取——fail()（失败态回填城市）与 GPS 按钮显隐都要用，
    // 放到文件末尾会因 var 提升读到 undefined。
    var cityName = (card.getAttribute("data-city") || "").trim();
    var tencentKey = (card.getAttribute("data-tencent-key") || "").trim();

    // ---- 常量 ----
    // 免 Key 链路（open-meteo / IP 定位）
    var URL_FORECAST = "https://api.open-meteo.com/v1/forecast";
    var URL_GEOCODE = "https://geocoding-api.open-meteo.com/v1/search";
    var URL_IP_SB = "https://api.ip.sb/geoip";
    var URL_IPWHO = "https://ipwho.is/";
    var URL_REVERSE =
      "https://api.bigdatacloud.net/data/reverse-geocode-client";
    var WX_CACHE_KEY = "weather_cache"; // sessionStorage，会话级
    var WX_CACHE_TTL = 30 * 60 * 1000;
    var GPS_KEY = "weather_gps_cache"; // localStorage，7 天避免重复弹窗
    var GPS_TTL = 7 * 24 * 3600 * 1000;
    var CLOCK_TICK = 1000;
    var GPS_TIMEOUT = 10000;
    var GPS_MAX_AGE = 600000;
    var GPS_HINT_RESET = 2500;
    // 腾讯链路（tencent_key 已配置时优先）：JSONP 通道与 IP 缓存由 Layout 注入的
    // __etherealTencent 提供，与欢迎弹窗共用同一份实现与同一个 sessionStorage key
    var tencent = window.__etherealTencent || null;

    // ---- 缓存读写（三处同构，统一走 readStore / writeStore）----
    // ttl 为 0 表示不校验时间；过期项顺手清掉，避免 sessionStorage 里堆无效条目。
    function readStore(store, key, ttl) {
      try {
        var raw = store.getItem(key);
        if (!raw) return null;
        var o = JSON.parse(raw);
        if (ttl && Date.now() - o.t > ttl) {
          store.removeItem(key);
          return null;
        }
        return o;
      } catch (e) {
        return null;
      }
    }
    function writeStore(store, key, value) {
      try {
        store.setItem(key, JSON.stringify(value));
      } catch (e) {}
    }
    function getCache() {
      var o = readStore(sessionStorage, WX_CACHE_KEY, WX_CACHE_TTL);
      // code 缺失说明是旧格式残留，按无缓存处理
      return o && o.data && o.data.code !== undefined ? o.data : null;
    }
    function setCache(d) {
      writeStore(sessionStorage, WX_CACHE_KEY, { data: d, t: Date.now() });
    }
    function getGpsCache() {
      var o = readStore(localStorage, GPS_KEY, GPS_TTL);
      return o && o.lat != null ? o : null;
    }
    function setGpsCache(lat, lon, name) {
      writeStore(localStorage, GPS_KEY, {
        lat: lat,
        lon: lon,
        name: name,
        t: Date.now(),
      });
    }
    function getCachedAdcode() {
      var o = tencent ? tencent.readIp() : null;
      return o && o.adcode ? o.adcode : null;
    }

    // ---- 秒级时钟 ----
    // 星期与月份名走 widget.calendar.*，与站点日历同源；日期行的语序由
    // widget.weather.dateFormat 决定，避免把中文语序写死在代码里。
    var WEEK_KEYS = [
      "sunday",
      "monday",
      "tuesday",
      "wednesday",
      "thursday",
      "friday",
      "saturday",
    ];
    var MONTH_KEYS = [
      "january",
      "february",
      "march",
      "april",
      "may",
      "june",
      "july",
      "august",
      "september",
      "october",
      "november",
      "december",
    ];
    var WEEK_FB = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    var MONTH_FB = [
      "January",
      "February",
      "March",
      "April",
      "May",
      "June",
      "July",
      "August",
      "September",
      "October",
      "November",
      "December",
    ];
    var WEEK = WEEK_KEYS.map(function (k, i) {
      return t("widget.calendar." + k, WEEK_FB[i]);
    });
    var MONTH = MONTH_KEYS.map(function (k, i) {
      return t("widget.calendar." + k, MONTH_FB[i]);
    });
    var cjk = /^zh/i.test(langTag);

    function pad(n) {
      return n < 10 ? "0" + n : "" + n;
    }
    // 日期行的单位、顺序与分隔符全部由 widget.weather.dateFormat 决定
    // （zh 为「{0}月{1}日 周{2}」，其他语言为「{0} {1}, {2}」），
    // 语序差异靠词条重排而非代码分支；{0} 在 zh 下是数字、其他语言是月份全名。
    function formatDate(d) {
      var m = d.getMonth();
      return t("widget.weather.dateFormat", "{0} {1}, {2}")
        .replace("{0}", cjk ? String(m + 1) : MONTH[m])
        .replace("{1}", String(d.getDate()))
        .replace("{2}", WEEK[d.getDay()]);
    }

    // 定时器挂在 card 上：脚本可能被 SwupScriptsPlugin 重执行，先清旧表防双表；
    // 元素离开 DOM（侧栏重建）时自停，不泄漏
    function tickClock() {
      if (!document.body.contains(card)) {
        if (card.__wxTimer) clearInterval(card.__wxTimer);
        return;
      }
      var d = new Date();
      if (elTime)
        elTime.textContent =
          pad(d.getHours()) +
          ":" +
          pad(d.getMinutes()) +
          ":" +
          pad(d.getSeconds());
      if (elDate) elDate.textContent = formatDate(d);
    }
    if (card.__wxTimer) clearInterval(card.__wxTimer);
    tickClock();
    card.__wxTimer = setInterval(tickClock, CLOCK_TICK);

    // ---- 天气：WMO 码 → 状况词条 / 图标 ----
    // 51-57 毛毛雨 / 61-67 雨 / 71-77 雪 / 80-82 阵雨 / 95+ 雷雨
    function wmoCondKey(code) {
      code = +code;
      if (code === 0) return "widget.weather.condSunny";
      if (code === 1) return "widget.weather.condPartlyCloudy";
      if (code === 2) return "widget.weather.condCloudy";
      if (code === 3) return "widget.weather.condOvercast";
      if (code === 45 || code === 48) return "widget.weather.condFog";
      if (code >= 51 && code <= 57) return "widget.weather.condDrizzle";
      if (code >= 61 && code <= 67) return "widget.weather.condRain";
      if (code >= 71 && code <= 77) return "widget.weather.condSnow";
      if (code >= 80 && code <= 82) return "widget.weather.condShowerRain";
      if (code === 85 || code === 86) return "widget.weather.condSnow";
      if (code >= 95) return "widget.weather.condThunder";
      return "widget.weather.condCloudy";
    }
    // 英文兜底只在 i18n 助手缺失时才会用到（t() 的 fb 参数），
    // 与 i18n 里的英文词条同源，不再单独维护第二份语义。
    function condFallback(key) {
      var fb = {
        "widget.weather.condSunny": "Sunny",
        "widget.weather.condPartlyCloudy": "Partly cloudy",
        "widget.weather.condCloudy": "Cloudy",
        "widget.weather.condOvercast": "Overcast",
        "widget.weather.condFog": "Fog",
        "widget.weather.condDrizzle": "Drizzle",
        "widget.weather.condRain": "Rain",
        "widget.weather.condShowerRain": "Showers",
        "widget.weather.condSnow": "Snow",
        "widget.weather.condThunder": "Thunderstorm",
      };
      return fb[key] || fb["widget.weather.condCloudy"];
    }
    function wmoIcon(code, day) {
      code = +code;
      if (code === 0) return day ? "mdi--weather-sunny" : "mdi--weather-night";
      if (code === 1 || code === 2) return "mdi--weather-cloudy";
      if (code === 3) return "mdi--weather-cloudy-alert";
      if (code === 45 || code === 48) return "mdi--weather-fog";
      if (code >= 51 && code <= 64) return "mdi--weather-rainy";
      if ((code >= 65 && code <= 67) || (code >= 80 && code <= 82))
        return "mdi--weather-pouring";
      if (code >= 71 && code <= 73) return "mdi--weather-snowy";
      if (code === 74 || code === 77 || code === 85 || code === 86)
        return "mdi--weather-snowy-heavy";
      if (code >= 95) return "mdi--weather-lightning-rainy";
      return "mdi--weather-cloudy";
    }

    // ---- 渲染 ----
    // 两条链路（open-meteo / 腾讯）统一先归一成 weather 对象再进这里，
    // 不再各写一份渲染逻辑；链路特有的补充文案由调用方通过 aux 覆盖。
    var TEMP_CLS =
      "text-3xl font-extrabold leading-none tabular-nums text-neutral-900 dark:text-neutral-100";
    var TEMP_CLS_FAIL =
      "text-2xl font-extrabold leading-none tabular-nums text-neutral-400 dark:text-neutral-500";

    function render(w) {
      if (elIcon)
        elIcon.innerHTML =
          '<span class="icon-[' +
          wmoIcon(w.code, w.day) +
          '] text-4xl"></span>';
      if (elTemp) {
        elTemp.textContent = Math.round(w.temp) + "°";
        elTemp.className = TEMP_CLS;
      }
      if (elCond) {
        var key = wmoCondKey(w.code);
        elCond.textContent = t(key, condFallback(key));
      }
      if (elCity) elCity.textContent = w.name || "--";
      if (elAux)
        elAux.textContent =
          t("widget.weather.wind", "风") +
          " " +
          Math.round(w.wind || 0) +
          " km/h · " +
          t("widget.weather.humidity", "湿度") +
          " " +
          Math.round(w.hum || 0) +
          "%";
    }

    // 失败态：城市保留后台配置值（IP/GPS 失败时也至少显示配置的城市名），其余清空
    function fail(msg) {
      if (elIcon)
        elIcon.innerHTML =
          '<span class="icon-[mdi--weather-cloudy] text-3xl"></span>';
      if (elTemp) {
        elTemp.textContent = "--°";
        elTemp.className = TEMP_CLS_FAIL;
      }
      if (elCond)
        elCond.textContent = msg || t("widget.weather.error", "天气加载失败");
      if (elCity) elCity.textContent = cityName || "--";
      if (elAux) elAux.textContent = "";
    }

    // ---- 免 Key 链路：城市名 geocode → 实况 / GPS 缓存 / IP 定位 ----
    function fetchWx(lat, lon, name) {
      fetch(
        URL_FORECAST +
          "?latitude=" +
          lat +
          "&longitude=" +
          lon +
          "&current=temperature_2m,weather_code,wind_speed_10m,relative_humidity_2m,is_day&timezone=auto",
      )
        .then(function (r) {
          return r.json();
        })
        .then(function (j) {
          var c = j && j.current;
          if (!c) return fail();
          var w = {
            name: name,
            code: c.weather_code,
            temp: c.temperature_2m,
            wind: c.wind_speed_10m,
            hum: c.relative_humidity_2m,
            day: c.is_day !== 0,
          };
          setCache(w);
          render(w);
        })
        .catch(function () {
          fail();
        });
    }

    // 城市名 / 英文地名 → open-meteo geocoding。
    // onMiss 让两处调用方各自决定「查不到」的语义：配置城市 → 提示未找到；
    // IP 定位回译 → 用原名兜底继续取天气。
    function geocode(name, lang, onHit, onMiss) {
      fetch(
        URL_GEOCODE +
          "?name=" +
          encodeURIComponent(name) +
          "&count=1&language=" +
          lang +
          "&format=json",
      )
        .then(function (r) {
          return r.json();
        })
        .then(function (j) {
          var g = j && j.results && j.results[0];
          if (!g) return onMiss();
          onHit(g);
        })
        .catch(function () {
          onMiss();
        });
    }

    function geocodeCity(name) {
      geocode(
        name,
        "zh",
        function (g) {
          fetchWx(g.latitude, g.longitude, g.name || name);
        },
        function () {
          fail(t("widget.weather.noCity", "未找到该城市"));
        },
      );
    }

    // IP 定位返回的常为英文地名，回译中文后再取天气；查不到直接用原名
    function resolveZh(enName, lat, lon) {
      var localName = t("widget.weather.currentLoc", "当前位置");
      if (!enName) return fetchWx(lat, lon, localName);
      geocode(
        enName,
        "zh",
        function (g) {
          fetchWx(lat, lon, g.name || enName);
        },
        function () {
          fetchWx(lat, lon, enName);
        },
      );
    }

    // IP 定位双源（均免 Key）：api.ip.sb 优先，ipwho.is 兜底
    function ipFrom(url, validate, onFail) {
      fetch(url)
        .then(function (r) {
          return r.json();
        })
        .then(function (j) {
          if (!validate(j)) return onFail();
          resolveZh(j.city || j.region || "", j.latitude, j.longitude);
        })
        .catch(onFail);
    }
    function ipFallback() {
      ipFrom(
        URL_IPWHO,
        function (j) {
          return j && j.success && j.latitude != null;
        },
        function () {
          fail(t("widget.weather.locFail", "定位失败，请在设置中填写城市"));
        },
      );
    }
    function ipGeo() {
      ipFrom(
        URL_IP_SB,
        function (j) {
          return j && j.latitude != null;
        },
        ipFallback,
      );
    }

    function openMeteoChain(name) {
      if (name) return geocodeCity(name);
      var gc = getGpsCache();
      if (gc)
        return fetchWx(
          gc.lat,
          gc.lon,
          gc.name || t("widget.weather.currentLoc", "当前位置"),
        );
      ipGeo();
    }

    // ---- GPS 精确定位（浏览器定位 + bigdatacloud 反地理编码）----
    // 仅在后台开启 gps 且未配置城市时显示按钮（配置了城市说明用户要固定城市）。
    if (gpsBtn) {
      var hasCity = !!cityName;
      gpsBtn.style.display = hasCity ? "none" : "";
      gpsBtn.addEventListener("click", function () {
        var label = t("widget.weather.gps", "使用精确定位");
        if (!navigator.geolocation) {
          if (gpsTxt)
            gpsTxt.textContent = t(
              "widget.weather.gpsUnsupported",
              "浏览器不支持定位",
            );
          return;
        }
        gpsBtn.disabled = true;
        if (gpsTxt)
          gpsTxt.textContent = t("widget.weather.gpsLocating", "定位中…");
        navigator.geolocation.getCurrentPosition(
          function (pos) {
            var lat = pos.coords.latitude;
            var lon = pos.coords.longitude;
            gpsBtn.disabled = false;
            if (gpsTxt) gpsTxt.textContent = label;
            fetch(
              URL_REVERSE +
                "?latitude=" +
                lat +
                "&longitude=" +
                lon +
                "&localityLanguage=zh",
            )
              .then(function (r) {
                return r.json();
              })
              .then(function (j) {
                var n =
                  (j && (j.city || j.locality || j.principalSubdivision)) ||
                  t("widget.weather.currentLoc", "当前位置");
                setGpsCache(lat, lon, n);
                fetchWx(lat, lon, n);
              })
              .catch(function () {
                var n = t("widget.weather.currentLoc", "当前位置");
                setGpsCache(lat, lon, n);
                fetchWx(lat, lon, n);
              });
          },
          function (err) {
            gpsBtn.disabled = false;
            if (gpsTxt)
              gpsTxt.textContent =
                err && err.code === 1
                  ? t("widget.weather.gpsDenied", "已拒绝授权")
                  : t("widget.weather.locFail", "定位失败，请在设置中填写城市");
            // 提示语几秒后还原成按钮文案，避免一直停在错误态
            setTimeout(function () {
              if (gpsTxt) gpsTxt.textContent = label;
            }, GPS_HINT_RESET);
          },
          {
            enableHighAccuracy: true,
            timeout: GPS_TIMEOUT,
            maximumAge: GPS_MAX_AGE,
          },
        );
      });
    }

    // ---- 腾讯链路（tencent_key 已配置时优先；失败/限流一律回退免 Key 兜底）----
    // JSONP 通道来自 Layout 注入的 __etherealTencent（与欢迎弹窗共用一份实现）
    function jsonp(url) {
      return tencent
        ? tencent.jsonp(url)
        : Promise.reject(new Error("tencent helper unavailable"));
    }

    // 腾讯中文天气描述 → WMO 码（复用统一的 render / i18n / 图标口径）
    function tencentCondToWmo(w) {
      w = String(w || "").replace(/\s+/g, "");
      if (/雷|冰雹/.test(w)) return 95;
      if (/雨夹雪/.test(w)) return 71;
      if (/阵雨/.test(w)) return 80;
      if (/冻雨|毛毛雨|细雨/.test(w)) return 51;
      if (/雪/.test(w)) {
        if (/暴|大到|中到/.test(w)) return 75;
        if (/大|中/.test(w)) return 73;
        return 71;
      }
      if (/雨/.test(w)) {
        if (/特大|暴雨|大到|大雨/.test(w)) return 65;
        if (/中雨/.test(w)) return 63;
        return 61;
      }
      if (/沙尘|浮尘|扬沙|霾|雾/.test(w)) return 45;
      if (/晴/.test(w) && /间|云/.test(w)) return 1;
      if (/多云/.test(w)) return 2;
      if (/阴/.test(w)) return 3;
      if (/晴/.test(w)) return 0;
      return 2;
    }

    // 腾讯实况归一成与 open-meteo 相同的 weather 对象，交给 render；
    // 风向/风力是腾讯独有字段，故在 render 之后补写 aux（wind 留空避免先写一次 0）。
    function renderTencent(rt) {
      var info = rt.infos || {};
      var hour = new Date().getHours();
      var w = {
        name: rt.district || rt.city || rt.province || "",
        code: tencentCondToWmo(info.weather),
        temp: parseFloat(info.temperature),
        wind: null,
        hum: parseFloat(info.humidity),
        day: !(hour >= 18 || hour < 6),
      };
      setCache(w);
      render(w);
      if (elAux) {
        var windText =
          ((info.wind_direction || "") + (info.wind_power_v2 || "")).trim() ||
          t("widget.weather.wind", "风");
        elAux.textContent =
          windText +
          " · " +
          t("widget.weather.humidity", "湿度") +
          " " +
          Math.round(parseFloat(info.humidity) || 0) +
          "%";
      }
    }

    function tencentChain(name, key) {
      function fetchWeather(adcode) {
        jsonp(
          tencent.base +
            "/weather/v1/?key=" +
            key +
            "&adcode=" +
            adcode +
            "&type=now&output=jsonp",
        )
          .then(function (data) {
            if (data && data.status === 0 && data.result)
              renderTencent(data.result);
            else openMeteoChain(name);
          })
          .catch(function () {
            openMeteoChain(name);
          });
      }
      if (/^\d+$/.test(name)) return fetchWeather(name);
      var cachedAdcode = getCachedAdcode();
      if (cachedAdcode) return fetchWeather(cachedAdcode);
      jsonp(tencent.base + "/location/v1/ip?key=" + key + "&output=jsonp")
        .then(function (data) {
          var info =
            data && data.status === 0 && data.result && data.result.ad_info;
          if (info && info.adcode) {
            tencent.writeIp(info.adcode, info);
            fetchWeather(String(info.adcode));
          } else {
            openMeteoChain(name);
          }
        })
        .catch(function () {
          openMeteoChain(name);
        });
    }

    // ---- 主流程：缓存 → 腾讯链路（有 Key）→ 免 Key 链路（默认）----
    var cached = getCache();
    if (cached) render(cached);
    else if (tencentKey) tencentChain(cityName, tencentKey);
    else openMeteoChain(cityName);
  })();
</script>
