---
// 时间天气小组件（对标 moesora「时间天气」）：天气大字置顶（图标 + 大温度 / 状况 + 城市）
// + 底部虚线时间行（秒级时钟 HH:MM:SS + M月D日 周X），可选「使用精确定位」GPS 按钮。
// - 天气数据双链路：① tencent_key 已配置 → 腾讯链路（JSONP：IP 定位→adcode→实况，
//   更贴近国内天气口径；失败/限流自动回退免 Key 兜底）；② tencent_key 留空（默认）→
//   免 Key 的 open-meteo 链路（城市名 geocode → 经纬度 → current 实况），城市留空时按
//   访客 IP 定位（api.ip.sb → ipwho.is 双源兜底），GPS 按钮走浏览器定位 +
//   bigdatacloud 反地理编码（localStorage 7 天缓存避免重复弹窗）
// - 后台配置（sidebar.weather 分组）：city 城市名（留空=IP 定位）、gps 精确定位按钮开关；
//   tencent_key 同时供欢迎弹窗 IP 定位复用（共享 weather_ip_cache）
// - 星期/月份文案复用 calendar.* 词条（与站点日历单一来源）；实例作用域取法同其他小组件，
//   双实例各自一份时钟（card.__wxTimer 去重，元素离 DOM 自停）
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
  class?: string;
}
const className = Astro.props.class;
---

<WidgetLayout
  name="时间天气"
  nameKey="widget.weather.title"
  id="weather"
  class={className}
>
  {/* 隐藏的图标元素，供 Tailwind 构建时检测生成 CSS（WMO 映射用到的 mdi 图标全部在此登记） */}
  <div class="hidden">
    <span class="icon-[mdi--loading]"></span>
    <span class="icon-[mdi--weather-sunny]"></span>
    <span class="icon-[mdi--weather-cloudy]"></span>
    <span class="icon-[mdi--weather-cloudy-alert]"></span>
    <span class="icon-[mdi--weather-rainy]"></span>
    <span class="icon-[mdi--weather-pouring]"></span>
    <span class="icon-[mdi--weather-lightning-rainy]"></span>
    <span class="icon-[mdi--weather-snowy]"></span>
    <span class="icon-[mdi--weather-snowy-heavy]"></span>
    <span class="icon-[mdi--weather-fog]"></span>
    <span class="icon-[mdi--weather-night]"></span>
    <span class="icon-[mdi--map-marker]"></span>
  </div>

  <div
    id="weather-content"
    th:attr="data-city=${theme.config?.sidebar?.weather?.city},
      data-tencent-key=${theme.config?.sidebar?.weather?.tencent_key}"
    class="wx-card px-3 py-1"
  >
    <!-- 天气主区：大图标 + 大温度 / 状况 + 城市 -->
    <div class="flex items-center gap-3.5 px-0.5 pb-2 pt-1">
      <span
        data-role="icon"
        class="flex h-[50px] w-[50px] flex-none items-center justify-center text-(--primary)"
      >
        <span class="icon-[mdi--loading] animate-spin text-4xl"></span>
      </span>
      <div class="min-w-0 flex-1">
        <div
          data-role="temp"
          class="text-3xl font-extrabold leading-none tabular-nums text-neutral-900 dark:text-neutral-100"
        >
          --°
        </div>
        <div class="mt-1 flex items-center gap-2 text-[13px]">
          <span
            data-role="cond"
            class="font-semibold text-neutral-700 dark:text-neutral-300"
            th:text="#{widget.weather.fetching}"
          >
            获取中…
          </span>
          <span class="inline-flex min-w-0 items-center gap-1 overflow-hidden">
            <span class="icon-[mdi--map-marker] shrink-0 text-xs text-(--primary)"></span>
            <span
              data-role="city"
              class="truncate text-neutral-500 dark:text-neutral-400"
            >
              --
            </span>
          </span>
        </div>
        <div
          data-role="aux"
          class="mt-1 text-xs text-neutral-400 dark:text-neutral-500"
        ></div>
      </div>
    </div>

    <!-- 时间行：虚线分隔 + 秒级时钟 / 日期（脚本填充） -->
    <div class="flex items-baseline justify-between gap-2 border-t border-dashed border-neutral-200 pt-2.5 dark:border-neutral-700">
      <span
        data-role="time"
        class="text-[17px] font-bold tabular-nums text-neutral-900 dark:text-neutral-100"
      >
        --:--:--
      </span>
      <span
        data-role="date"
        class="text-xs text-neutral-500 dark:text-neutral-400"
      >
        ----
      </span>
    </div>

    <!-- GPS 精确定位按钮：后台 gps 开关开启才渲染，城市留空时客户端显示 -->
    <button
      type="button"
      data-role="gps"
      th:if="${theme.config?.sidebar?.weather?.gps == true}"
      class="mx-auto mt-2.5 inline-flex items-center gap-1.5 rounded-full border border-neutral-200 px-3 py-1 text-xs text-(--primary) transition-colors hover:bg-(--btn-plain-bg-hover) dark:border-neutral-700"
      style="display: none"
    >
      <span class="icon-[mdi--map-marker] text-xs"></span>
      <span data-role="gpstext" th:text="#{widget.weather.gps}">
        使用精确定位
      </span>
    </button>
  </div>
</WidgetLayout>

<script is:inline>
  (function () {
    // 实例作用域：脚本 is:inline、每实例各跑一份，重复配置（左栏 + 右栏、桌面 + 移动端列表）
    // 时只操作本实例——currentScript 取本实例所在条目容器再查元素，
    // 否则永远命中文档第一个实例，重复的那份是空壳。
    var widgetRoot =
      (document.currentScript && document.currentScript.parentElement) ||
      document;
    var card = widgetRoot.querySelector(".wx-card");
    if (!card) return;

    var t =
      window.__etherealI18n ||
      function (_key, fb) {
        return fb;
      };
    // 语言标签归一化：zh* 用「M月D日 周X」，其余用「Mon D, X」
    var langTag = (
      window.__etherealLangTag ||
      function () {
        return "en";
      }
    )(document.documentElement.lang);
    var isCJK = langTag !== "en";

    var elIcon = card.querySelector('[data-role="icon"]');
    var elTemp = card.querySelector('[data-role="temp"]');
    var elCond = card.querySelector('[data-role="cond"]');
    var elCity = card.querySelector('[data-role="city"]');
    var elAux = card.querySelector('[data-role="aux"]');
    var elTime = card.querySelector('[data-role="time"]');
    var elDate = card.querySelector('[data-role="date"]');
    var gpsBtn = card.querySelector('[data-role="gps"]');
    var gpsTxt = gpsBtn ? gpsBtn.querySelector('[data-role="gpstext"]') : null;

    // ---- 秒级时钟（星期/月份复用 calendar.* 词条，与站点日历单一来源）----
    var WK = [
      "sunday",
      "monday",
      "tuesday",
      "wednesday",
      "thursday",
      "friday",
      "saturday",
    ].map(function (k, i) {
      return t(
        "calendar." + k,
        ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][i],
      );
    });
    var MON = [
      "january",
      "february",
      "march",
      "april",
      "may",
      "june",
      "july",
      "august",
      "september",
      "october",
      "november",
      "december",
    ].map(function (k, i) {
      return t(
        "calendar." + k,
        [
          "January",
          "February",
          "March",
          "April",
          "May",
          "June",
          "July",
          "August",
          "September",
          "October",
          "November",
          "December",
        ][i],
      );
    });
    function pad(n) {
      return n < 10 ? "0" + n : "" + n;
    }
    // 定时器挂在 card 上：脚本可能被 SwupScriptsPlugin 重执行，先清旧表防双表；
    // 元素离开 DOM（侧栏重建）时自停，不泄漏
    function tickClock() {
      if (!document.body.contains(card)) {
        if (card.__wxTimer) clearInterval(card.__wxTimer);
        return;
      }
      var d = new Date();
      if (elTime)
        elTime.textContent =
          pad(d.getHours()) +
          ":" +
          pad(d.getMinutes()) +
          ":" +
          pad(d.getSeconds());
      if (elDate)
        elDate.textContent = isCJK
          ? d.getMonth() + 1 + "月" + d.getDate() + "日 周" + WK[d.getDay()]
          : MON[d.getMonth()] + " " + d.getDate() + ", " + WK[d.getDay()];
    }
    if (card.__wxTimer) clearInterval(card.__wxTimer);
    tickClock();
    card.__wxTimer = setInterval(tickClock, 1000);

    // ---- 天气（免 Key：open-meteo；城市留空走 IP 定位 / GPS 缓存）----
    var WX_CACHE_KEY = "weather_cache"; // 沿用既有键（sessionStorage，会话级）
    var WX_CACHE_TTL = 30 * 60 * 1000; // 天气缓存 30 分钟
    var GPS_KEY = "weather_gps_cache";
    var GPS_TTL = 7 * 24 * 3600 * 1000; // GPS 定位 7 天有效，避免重复弹窗

    function getCache() {
      try {
        var raw = sessionStorage.getItem(WX_CACHE_KEY);
        if (!raw) return null;
        var o = JSON.parse(raw);
        if (
          o &&
          o.data &&
          o.data.code !== undefined &&
          Date.now() - o.timestamp < WX_CACHE_TTL
        )
          return o.data;
        return null;
      } catch (e) {
        return null;
      }
    }
    function setCache(d) {
      try {
        sessionStorage.setItem(
          WX_CACHE_KEY,
          JSON.stringify({ data: d, timestamp: Date.now() }),
        );
      } catch (e) {}
    }
    function getGpsCache() {
      try {
        var o = JSON.parse(localStorage.getItem(GPS_KEY) || "null");
        if (o && o.lat != null && Date.now() - o.t < GPS_TTL) return o;
      } catch (e) {}
      return null;
    }
    function setGpsCache(lat, lon, name) {
      try {
        localStorage.setItem(
          GPS_KEY,
          JSON.stringify({ lat: lat, lon: lon, name: name, t: Date.now() }),
        );
      } catch (e) {}
    }

    // WMO 码 → i18n 状况键（映射口径同 moesora：51-57 毛毛雨 / 61-67 雨 / 71-77 雪 / 80-82 阵雨 / 95+ 雷雨）
    function wmoCondKey(code) {
      code = +code;
      if (code === 0) return "widget.weather.condSunny";
      if (code === 1) return "widget.weather.condPartlyCloudy";
      if (code === 2) return "widget.weather.condCloudy";
      if (code === 3) return "widget.weather.condOvercast";
      if (code === 45 || code === 48) return "widget.weather.condFog";
      if (code >= 51 && code <= 57) return "widget.weather.condDrizzle";
      if (code >= 61 && code <= 67) return "widget.weather.condRain";
      if (code >= 71 && code <= 77) return "widget.weather.condSnow";
      if (code >= 80 && code <= 82) return "widget.weather.condShowerRain";
      if (code === 85 || code === 86) return "widget.weather.condSnow";
      if (code >= 95) return "widget.weather.condThunder";
      return "widget.weather.condCloudy";
    }
    function condFallback(key) {
      var fb = {
        "widget.weather.condSunny": "Sunny",
        "widget.weather.condPartlyCloudy": "Partly cloudy",
        "widget.weather.condCloudy": "Cloudy",
        "widget.weather.condOvercast": "Overcast",
        "widget.weather.condFog": "Fog",
        "widget.weather.condDrizzle": "Drizzle",
        "widget.weather.condRain": "Rain",
        "widget.weather.condShowerRain": "Showers",
        "widget.weather.condSnow": "Snow",
        "widget.weather.condThunder": "Thunderstorm",
      };
      return fb[key] || "Cloudy";
    }
    // WMO 码 → 图标（沿用本项目 mdi 图标体系；0 号按昼夜分太阳/月亮）
    function wmoIcon(code, day) {
      code = +code;
      if (code === 0) return day ? "mdi--weather-sunny" : "mdi--weather-night";
      if (code === 1 || code === 2) return "mdi--weather-cloudy";
      if (code === 3) return "mdi--weather-cloudy-alert";
      if (code === 45 || code === 48) return "mdi--weather-fog";
      if (code >= 51 && code <= 64) return "mdi--weather-rainy";
      if ((code >= 65 && code <= 67) || (code >= 80 && code <= 82))
        return "mdi--weather-pouring";
      if (code >= 71 && code <= 73) return "mdi--weather-snowy";
      if (code === 74 || code === 77 || code === 85 || code === 86)
        return "mdi--weather-snowy-heavy";
      if (code >= 95) return "mdi--weather-lightning-rainy";
      return "mdi--weather-cloudy";
    }

    function render(d) {
      if (elIcon)
        elIcon.innerHTML =
          '<span class="icon-[' +
          wmoIcon(d.code, d.day) +
          '] text-4xl"></span>';
      if (elTemp) {
        elTemp.textContent = Math.round(d.temp) + "°";
        elTemp.className =
          "text-3xl font-extrabold leading-none tabular-nums text-neutral-900 dark:text-neutral-100";
      }
      if (elCond)
        elCond.textContent = t(
          wmoCondKey(d.code),
          condFallback(wmoCondKey(d.code)),
        );
      if (elCity) elCity.textContent = d.name || "--";
      if (elAux)
        elAux.textContent =
          t("widget.weather.wind", "风") +
          " " +
          Math.round(d.wind || 0) +
          " km/h · " +
          t("widget.weather.humidity", "湿度") +
          " " +
          Math.round(d.hum || 0) +
          "%";
    }

    function fail(msg) {
      if (elIcon)
        elIcon.innerHTML =
          '<span class="icon-[mdi--weather-cloudy] text-3xl"></span>';
      if (elTemp) {
        elTemp.textContent = "--°";
        // 失败态：温度灰化缩小（同 moesora is-fail）
        elTemp.className =
          "text-2xl font-extrabold leading-none tabular-nums text-neutral-400 dark:text-neutral-500";
      }
      if (elCond)
        elCond.textContent = msg || t("widget.weather.error", "天气加载失败");
      if (elCity)
        elCity.textContent =
          (card.getAttribute("data-city") || "").trim() || "--";
      if (elAux) elAux.textContent = "";
    }

    function fetchWx(lat, lon, name) {
      fetch(
        "https://api.open-meteo.com/v1/forecast?latitude=" +
          lat +
          "&longitude=" +
          lon +
          "&current=temperature_2m,weather_code,wind_speed_10m,relative_humidity_2m,is_day&timezone=auto",
      )
        .then(function (r) {
          return r.json();
        })
        .then(function (j) {
          var c = j && j.current;
          if (!c) return fail();
          var d = {
            name: name,
            code: c.weather_code,
            temp: c.temperature_2m,
            wind: c.wind_speed_10m,
            hum: c.relative_humidity_2m,
            day: c.is_day !== 0,
          };
          setCache(d);
          render(d);
        })
        .catch(function () {
          fail();
        });
    }

    // 城市名 → 中文 geocode → 实况
    function geocodeCity(city) {
      fetch(
        "https://geocoding-api.open-meteo.com/v1/search?name=" +
          encodeURIComponent(city) +
          "&count=1&language=zh&format=json",
      )
        .then(function (r) {
          return r.json();
        })
        .then(function (j) {
          var g = j && j.results && j.results[0];
          if (!g) return fail(t("widget.weather.noCity", "未找到该城市"));
          fetchWx(g.latitude, g.longitude, g.name || city);
        })
        .catch(function () {
          fail();
        });
    }

    // 英文城市名回译中文（IP 定位返回的常为英文）；查不到直接用原名
    function resolveZh(enName, lat, lon) {
      var localName = t("widget.weather.currentLoc", "当前位置");
      if (!enName) {
        fetchWx(lat, lon, localName);
        return;
      }
      fetch(
        "https://geocoding-api.open-meteo.com/v1/search?name=" +
          encodeURIComponent(enName) +
          "&count=1&language=zh&format=json",
      )
        .then(function (r) {
          return r.json();
        })
        .then(function (j) {
          var g = j && j.results && j.results[0];
          fetchWx(lat, lon, (g && g.name) || enName);
        })
        .catch(function () {
          fetchWx(lat, lon, enName);
        });
    }
    // IP 定位双源兜底（均免 Key）：api.ip.sb 优先，ipwho.is 兜底
    function ipFallback() {
      var locFailMsg = t(
        "widget.weather.locFail",
        "定位失败，请在设置中填写城市",
      );
      fetch("https://ipwho.is/")
        .then(function (r) {
          return r.json();
        })
        .then(function (j) {
          if (!j || !j.success || j.latitude == null) return fail(locFailMsg);
          resolveZh(j.city || j.region || "", j.latitude, j.longitude);
        })
        .catch(function () {
          fail(locFailMsg);
        });
    }
    function ipGeo() {
      fetch("https://api.ip.sb/geoip")
        .then(function (r) {
          return r.json();
        })
        .then(function (j) {
          if (!j || j.latitude == null) return ipFallback();
          resolveZh(j.city || j.region || "", j.latitude, j.longitude);
        })
        .catch(ipFallback);
    }

    // ---- GPS 精确定位（后台 gps 开关开启才渲染按钮；城市留空时显示，点按取浏览器定位）----
    if (gpsBtn) {
      var citySet = !!(card.getAttribute("data-city") || "").trim();
      gpsBtn.style.display = citySet ? "none" : "";
      gpsBtn.addEventListener("click", function () {
        var gpsLabel = t("widget.weather.gps", "使用精确定位");
        if (!navigator.geolocation) {
          if (gpsTxt)
            gpsTxt.textContent = t(
              "widget.weather.gpsUnsupported",
              "浏览器不支持定位",
            );
          return;
        }
        gpsBtn.disabled = true;
        if (gpsTxt)
          gpsTxt.textContent = t("widget.weather.gpsLocating", "定位中…");
        navigator.geolocation.getCurrentPosition(
          function (pos) {
            var la = pos.coords.latitude;
            var lo = pos.coords.longitude;
            gpsBtn.disabled = false;
            if (gpsTxt) gpsTxt.textContent = gpsLabel;
            fetch(
              "https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=" +
                la +
                "&longitude=" +
                lo +
                "&localityLanguage=zh",
            )
              .then(function (r) {
                return r.json();
              })
              .then(function (j) {
                var nm =
                  (j && (j.city || j.locality || j.principalSubdivision)) ||
                  t("widget.weather.currentLoc", "当前位置");
                setGpsCache(la, lo, nm);
                fetchWx(la, lo, nm);
              })
              .catch(function () {
                var nm = t("widget.weather.currentLoc", "当前位置");
                setGpsCache(la, lo, nm);
                fetchWx(la, lo, nm);
              });
          },
          function (err) {
            gpsBtn.disabled = false;
            if (gpsTxt) {
              gpsTxt.textContent =
                err && err.code === 1
                  ? t("widget.weather.gpsDenied", "已拒绝授权")
                  : t("widget.weather.locFail", "定位失败，请在设置中填写城市");
              setTimeout(function () {
                gpsTxt.textContent = gpsLabel;
              }, 2500);
            }
          },
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 600000 },
        );
      });
    }

    // ---- 免 Key 链路（默认）：城市名 geocode → 实况 / GPS 缓存 / IP 定位 ----
    function openMeteoChain(city) {
      if (city) {
        geocodeCity(city);
        return;
      }
      var gc = getGpsCache();
      if (gc) {
        fetchWx(
          gc.lat,
          gc.lon,
          gc.name || t("widget.weather.currentLoc", "当前位置"),
        );
        return;
      }
      ipGeo();
    }

    // ---- 腾讯链路（tencent_key 已配置时优先；失败/限流一律回退免 Key 兜底，保证天气始终显示）----
    var API_BASE = "https://apis.map.qq.com/ws";
    var IP_CACHE_KEY = "weather_ip_cache"; // 与欢迎弹窗共享：4 小时 TTL
    var IP_CACHE_TTL = 4 * 60 * 60 * 1000;

    var _cbIdx = 0;
    function jsonp(url) {
      return new Promise(function (resolve, reject) {
        var cbName = "__ethereal_tencent_cb_" + ++_cbIdx;
        var sep = url.indexOf("?") === -1 ? "?" : "&";
        var script = document.createElement("script");
        script.src = url + sep + "callback=" + cbName;
        script.onerror = function () {
          reject(new Error("JSONP request failed"));
          cleanup();
        };
        var timer = setTimeout(function () {
          reject(new Error("JSONP timeout"));
          cleanup();
        }, 10000);
        function cleanup() {
          clearTimeout(timer);
          try {
            delete window[cbName];
          } catch (e) {
            window[cbName] = undefined;
          }
          if (script.parentNode) script.parentNode.removeChild(script);
        }
        window[cbName] = function (data) {
          resolve(data);
          cleanup();
        };
        document.head.appendChild(script);
      });
    }

    function getCachedAdcode() {
      try {
        var raw = sessionStorage.getItem(IP_CACHE_KEY);
        if (!raw) return null;
        var d = JSON.parse(raw);
        if (d.adcode && Date.now() - d.t < IP_CACHE_TTL) return d.adcode;
      } catch (e) {}
      return null;
    }
    function setCachedAdcode(adcode, adInfo) {
      try {
        sessionStorage.setItem(
          IP_CACHE_KEY,
          JSON.stringify({
            adcode: adcode,
            ad_info: adInfo || null,
            t: Date.now(),
          }),
        );
      } catch (e) {}
    }

    // 腾讯中文天气描述 → WMO 码（复用统一 render/i18n/图标口径）
    function tencentCondToWmo(w) {
      w = String(w || "").replace(/\s+/g, "");
      if (/雷|冰雹/.test(w)) return 95;
      if (/雨夹雪/.test(w)) return 71;
      if (/阵雨/.test(w)) return 80;
      if (/冻雨|毛毛雨|细雨/.test(w)) return 51;
      if (/雪/.test(w)) {
        if (/暴|大到|中到/.test(w)) return 75;
        if (/大|中/.test(w)) return 73;
        return 71;
      }
      if (/雨/.test(w)) {
        if (/特大|暴雨|大到/.test(w)) return 65;
        if (/大雨/.test(w)) return 65;
        if (/中雨/.test(w)) return 63;
        return 61;
      }
      if (/沙尘|浮尘|扬沙|霾|雾/.test(w)) return 45;
      if (/晴/.test(w) && /间|云/.test(w)) return 1;
      if (/多云/.test(w)) return 2;
      if (/阴/.test(w)) return 3;
      if (/晴/.test(w)) return 0;
      return 2;
    }

    function renderTencent(rt) {
      var info = rt.infos || {};
      var night = new Date().getHours() >= 18 || new Date().getHours() < 6;
      var d = {
        name: rt.district || rt.city || rt.province || "",
        code: tencentCondToWmo(info.weather),
        temp: parseFloat(info.temperature),
        wind: 0,
        hum: parseFloat(info.humidity),
        day: !night,
      };
      setCache(d);
      render(d);
      if (elAux) {
        var windText =
          ((info.wind_direction || "") + (info.wind_power_v2 || "")).trim() ||
          t("widget.weather.wind", "风");
        elAux.textContent =
          windText +
          " · " +
          t("widget.weather.humidity", "湿度") +
          " " +
          Math.round(parseFloat(info.humidity) || 0) +
          "%";
      }
    }

    function tencentChain(city, key) {
      function fetchTencentWeather(adcode) {
        jsonp(
          API_BASE +
            "/weather/v1/?key=" +
            key +
            "&adcode=" +
            adcode +
            "&type=now&output=jsonp",
        )
          .then(function (data) {
            if (data && data.status === 0 && data.result)
              renderTencent(data.result);
            else openMeteoChain(city);
          })
          .catch(function () {
            openMeteoChain(city);
          });
      }
      if (/^\d+$/.test(city)) {
        fetchTencentWeather(city);
        return;
      }
      var cachedAdcode = getCachedAdcode();
      if (cachedAdcode) {
        fetchTencentWeather(cachedAdcode);
        return;
      }
      jsonp(API_BASE + "/location/v1/ip?key=" + key + "&output=jsonp")
        .then(function (data) {
          if (
            data &&
            data.status === 0 &&
            data.result &&
            data.result.ad_info &&
            data.result.ad_info.adcode
          ) {
            var code = String(data.result.ad_info.adcode);
            setCachedAdcode(code, data.result.ad_info);
            fetchTencentWeather(code);
          } else {
            openMeteoChain(city);
          }
        })
        .catch(function () {
          openMeteoChain(city);
        });
    }

    // ---- 主流程：缓存 → 腾讯链路（有 Key）→ 免 Key 链路（默认）----
    var city = (card.getAttribute("data-city") || "").trim();
    var tencentKey = (card.getAttribute("data-tencent-key") || "").trim();
    var cached = getCache();
    if (cached) {
      render(cached);
    } else if (tencentKey) {
      tencentChain(city, tencentKey);
    } else {
      openMeteoChain(city);
    }
  })();
</script>
